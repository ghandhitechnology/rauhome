# Copy to .env and fill in what you use.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
KIMI_CODING_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Alternative text-to-speech provider (Sonic 3.5).
CARTESIA_API_KEY=
COMPOSIO_API_KEY=
# Streaming speech-to-text for voice mode. Optional — Automatic hearing prefers
# it, then falls back to ElevenLabs Scribe v2, OpenAI, or local whisper.
DEEPGRAM_API_KEY=

# Web browsing — connect either, or both (pick which in Settings)
FIRECRAWL_API_KEY=
BROWSERBASE_API_KEY=
# Optional: only needed if your Browserbase key does not imply a project
BROWSERBASE_PROJECT_ID=
