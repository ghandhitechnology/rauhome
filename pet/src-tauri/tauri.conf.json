{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rau Pet",
  "version": "0.1.0",
  "identifier": "com.rau.pet",
  "build": {
    "frontendDist": "../dist-placeholder",
    "devUrl": "http://127.0.0.1:8765/pet"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rau Pet",
        "width": 280,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "shadow": false,
        "url": "http://127.0.0.1:8765/pet"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
